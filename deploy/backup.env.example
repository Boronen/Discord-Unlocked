# Install as ignored secrets/backup.env after verifying the independent destination.
BACKUP_KEY_FILE=/private/key-custody/backup.key
OFFSITE_BACKUP_DIR=/mnt/operator-private-backups/profile-studio
# Generate a UUID and put the same value in .profile-studio-offsite-id ON THE MOUNTED REMOTE DESTINATION.
# The underlying unmounted local directory must NOT contain that marker.
OFFSITE_BACKUP_ID=
