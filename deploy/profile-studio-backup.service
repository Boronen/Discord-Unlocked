[Unit]
Description=Encrypted Profile Studio offsite backup
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=profile-operator
WorkingDirectory=/srv/profile-studio/app
EnvironmentFile=/srv/profile-studio/app/secrets/backup.env
ExecStart=/usr/bin/node scripts/daily-backup.mjs
UMask=0077
Nice=10
TimeoutStartSec=30min
